MONGO_URI=mongodb://localhost:27017/quizarena
JWT_SECRET=replace-with-a-long-random-secret
PORT=9000

# SMTP settings used for email verification and password reset codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=QuizArena <no-reply@example.com>

# Twilio settings used for OTP delivery to phone numbers.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
